#!/usr/bin/env python3
"""Validate workflow v1/v2 or retain one fresh read-only v2 observation."""
import argparse
import json
from pathlib import Path
import sys

from jsonschema import Draft202012Validator, ValidationError

from workflow_contract import ContractError, load_json, parse_json, readiness_blockers, validate_contract
from workflow_identity import IdentityError, write_record
import workflow_v2


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.exit(2, "Invalid workflow command. Use shoko-workflow --help.\n")


def main():
    parser = Parser(description=__doc__)
    parser.add_argument("command", choices=["validate", "check", "observe"])
    parser.add_argument("--manifest", required=True, type=Path)
    parser.add_argument("--structure-only", action="store_true")
    parser.add_argument("--artifacts", type=Path, default=Path(".shoko/observations"))
    args = parser.parse_args()
    if args.structure_only and args.command != "validate":
        parser.error("invalid structure-only mode")
    root = Path(__file__).resolve().parent.parent
    try:
        with args.manifest.open("rb") as handle:
            raw = handle.read(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024:
            raise ContractError("workflow-manifest-too-large")
        value = parse_json(raw)
        version = value.get("schemaVersion") if isinstance(value, dict) else None
        if type(version) is not int or version not in (1, 2):
            raise ContractError("unsupported-workflow-schema")
        schema = load_json(root / f"schemas/workflow-v{version}.schema.json")
        value = validate_contract(value, schema) if version == 1 else workflow_v2.validate(value, schema)
        if args.command == "validate":
            pending = readiness_blockers(value) if version == 1 else workflow_v2.blockers(value)
            if not args.structure_only and (value["purpose"] != "staging-contract" or pending):
                raise ContractError("unconfirmed-staging-prerequisites")
            print(json.dumps({"kind": "workflow-structure-check", "schemaVersion": version, "valid": True, "liveReadinessChecked": False, "pendingPrerequisites": len(pending)}))
            return 0
        if version == 1:
            raise ContractError("workflow-v1-live-check-use-legacy-identity-command")
        record = workflow_v2.observe(value, raw)
        artifact_schema = load_json(root / "schemas/target-observation-v1.schema.json")
        try:
            Draft202012Validator(artifact_schema).validate(record)
        except ValidationError:
            print("Workflow observation protocol fault", file=sys.stderr)
            return 4
        try:
            path = write_record(record, args.artifacts)
        except IdentityError:
            print("Workflow artifact persistence fault", file=sys.stderr)
            return 4
        print(json.dumps({"kind": "workflow-readiness", "readinessStatus": record["readinessStatus"], "blockers": record["blockers"], "artifact": str(path)}))
        return 0 if record["readinessStatus"] == "ready" else 2
    except (ContractError, IdentityError) as error:
        print(str(error), file=sys.stderr)
        return 2
    except (OSError, ValueError, RecursionError):
        print("Workflow input unavailable or invalid", file=sys.stderr)
        return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("Workflow observation interrupted", file=sys.stderr)
        raise SystemExit(4) from None
