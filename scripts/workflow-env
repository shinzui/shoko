#!/usr/bin/env python3
"""Validate a workflow contract offline. Live check/smoke await the target contract."""

import argparse
from pathlib import Path
import sys

from workflow_contract import ContractError, load_json, readiness_blockers, validate_contract


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["validate", "check", "smoke"])
    root = Path(__file__).resolve().parent.parent
    parser.add_argument("--manifest", type=Path, default=root / "integration/workflow.json")
    args = parser.parse_args()
    try:
        value = validate_contract(load_json(args.manifest), load_json(root / "schemas/workflow-v1.schema.json"))
        if value["purpose"] != "staging-contract":
            raise ContractError("synthetic example is not an approved staging contract")
        blockers = readiness_blockers(value)
        if blockers:
            # Only stable IDs go to the terminal, never arbitrary manifest prose.
            print("Unmet staging prerequisites: " + ", ".join(p["id"] for p in blockers), file=sys.stderr)
            return 2
        if args.command != "validate":
            raise ContractError("live check/smoke implementation awaits the approved target/access contract; no calls made")
        print("Workflow contract v1 is structurally valid; live readiness has not been checked.")
        return 0
    except ContractError as error:
        print(str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
