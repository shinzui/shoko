#!/usr/bin/env python3
"""Run isolated email checks without PostgreSQL, Kafka, credentials, or delivery."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

root = Path.cwd()
package = root / "shoko-adapters" if (root / "shoko-adapters").is_dir() else root
with tempfile.TemporaryDirectory(prefix="shoko-email-", dir="/tmp") as temporary:
    port = Path(temporary) / "port"
    server = subprocess.Popen([sys.executable, str(package / "test/Email/Fixture/server.py"), str(port)],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        deadline = time.monotonic() + 10
        while not port.exists():
            if server.poll() is not None or time.monotonic() > deadline:
                raise RuntimeError("email fixture startup failed")
            time.sleep(0.02)
        env = dict(os.environ, SHOKO_TEST_EMAIL="http://127.0.0.1:" + port.read_text())
        env.update({name: "http://127.0.0.1:1" for name in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY")})
        env.update(no_proxy="", NO_PROXY="")
        if len(sys.argv) == 3 and sys.argv[1] == "--binaries":
            command = [str((root / sys.argv[2] / "email-adapter-test/email-adapter-test").resolve())]
        elif len(sys.argv) == 1:
            command = ["cabal", "test", "email-adapter-test", "--test-show-details=direct"]
        else:
            raise RuntimeError("invalid email test arguments")
        if len(sys.argv) == 1:
            build = subprocess.run(["cabal", "build", "exe:shoko-email-smoke"], env=env, capture_output=True)
            if build.returncode:
                sys.stdout.buffer.write(build.stdout)
                sys.stderr.buffer.write(build.stderr)
                raise SystemExit(build.returncode)
            located = subprocess.run(["cabal", "list-bin", "exe:shoko-email-smoke"], env=env, capture_output=True, text=True, check=True)
            host = Path(located.stdout.strip())
        else:
            host = (root / sys.argv[2] / "shoko-email-smoke/shoko-email-smoke").resolve()
        result = subprocess.run(command, env=env, capture_output=True)
        output = result.stdout + result.stderr
        sentinels = (b"CONTENT-PRIVATE", b"HTML-PRIVATE", b"HEADER-PRIVATE", b"FILENAME-PRIVATE", b"URL-PRIVATE", b"ERROR-PRIVATE", b"FROM-PRIVATE", b"CREDENTIAL-PRIVATE")
        if any(value in output for value in sentinels):
            raise RuntimeError("email process output leaked private evidence")
        sys.stdout.buffer.write(result.stdout)
        sys.stderr.buffer.write(result.stderr)
        if result.returncode:
            raise SystemExit(result.returncode)
        wrapper = Path(os.environ.get("SHOKO_TEST_SMOKE_WRAPPER", str(root / "scripts/smoke-email")))
        host_check = Path(os.environ.get("SHOKO_TEST_EMAIL_HOST_CHECK", str(root / "scripts/test-email-host")))
        subprocess.run([sys.executable, "-P", str(host_check), str(host), str(wrapper)], check=True, env=env)
        print("Bounded receiving and controlled sending fixture acceptance passed (loopback only).")
    finally:
        server.terminate()
        server.wait(timeout=5)
