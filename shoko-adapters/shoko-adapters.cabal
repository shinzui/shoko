cabal-version: 3.12
name: shoko-adapters
version: 0.1.0.0
synopsis: Scoped SQL and bounded HTTP evidence for Shoko
description: Generic transport adapters for typed Shoko context bindings.
license: BSD-3-Clause
license-file: LICENSE
author: Shoko contributors
maintainer: shinzui@users.noreply.github.com
category: Testing
build-type: Simple
tested-with: ghc ==9.12.4
extra-source-files:
  test/EventStore/Fixture/kiroku/LICENSE
  test/EventStore/Fixture/kiroku/migrations/*.sql
  test/EventStore/Fixture/kiroku/migrations/manifest
  test/EventStore/Fixture/message-db/MIT-License.txt
  test/EventStore/Fixture/message-db/database/**/*.sql
  test/EventStore/Fixture/sources.json
  test/Fixture/server.py

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates

  build-depends:
    base >=4.21 && <4.22,
    bytestring >=0.12.2 && <0.13,
    containers >=0.7 && <0.8,
    hasql >=1.10.3.7 && <1.11,
    shoko-core >=0.1 && <0.2,
    text >=2.1.4 && <2.2,

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Shoko.Adapter.EventStore
    Shoko.Adapter.Http
    Shoko.Adapter.Http.Evidence
    Shoko.Adapter.Http.Request
    Shoko.Adapter.Kiroku
    Shoko.Adapter.Kiroku.Evidence
    Shoko.Adapter.MessageDb
    Shoko.Adapter.MessageDb.Evidence
    Shoko.Adapter.Postgres
    Shoko.Adapter.Postgres.Evidence
    Shoko.Adapter.Postgres.Query

  other-modules: Shoko.Adapter.EventStore.Internal
  build-depends:
    aeson >=2.2 && <2.3,
    http-client >=0.7.19 && <0.8,
    http-client-tls >=0.3.6.4 && <0.4,
    http-types >=0.12.4 && <0.13,
    kiroku-store >=0.11 && <0.12,
    postgresql-connection-string >=0.1.0.6 && <0.2,
    time >=1.12 && <1.15,
    uuid >=1.3 && <1.4,
    vector >=0.13 && <0.14,

test-suite postgres-adapter-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: PostgresMain.hs
  other-modules: AdapterTests
  ghc-options: -threaded
  build-depends:
    hedgehog >=1.5 && <1.8,
    shoko-adapters,
    tasty >=1.5.4 && <1.6,
    tasty-hedgehog >=1.4.0.2 && <1.5,

test-suite http-adapter-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: HttpMain.hs
  other-modules: AdapterTests
  ghc-options: -threaded
  build-depends:
    hedgehog >=1.5 && <1.8,
    shoko-adapters,
    tasty >=1.5.4 && <1.6,
    tasty-hedgehog >=1.4.0.2 && <1.5,

test-suite adapter-roundtrip-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: RoundtripMain.hs
  other-modules: AdapterTests
  ghc-options: -threaded
  build-depends:
    hedgehog >=1.5 && <1.8,
    shoko-adapters,
    tasty >=1.5.4 && <1.6,
    tasty-hedgehog >=1.4.0.2 && <1.5,

test-suite event-store-adapter-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: EventStoreMain.hs
  other-modules: EventStore.Contract
  ghc-options: -threaded
  build-depends:
    aeson >=2.2 && <2.3,
    async >=2.2 && <2.3,
    hedgehog >=1.5 && <1.8,
    kiroku-store >=0.11 && <0.12,
    shoko-adapters,
    tasty >=1.5.4 && <1.6,
    tasty-hedgehog >=1.4.0.2 && <1.5,
    time >=1.12 && <1.15,
    uuid >=1.3 && <1.4,
    vector >=0.13 && <0.14,

source-repository head
  type: git
  location: https://github.com/shinzui/shoko
