cabal-version: 3.12
name: shoko-adapters
version: 0.1.0.0
synopsis: Scoped SQL and bounded HTTP evidence for Shoko
description: Generic transport adapters for typed Shoko context bindings.
license: BSD-3-Clause
license-file: LICENSE
author: Shoko contributors
maintainer: shinzui@users.noreply.github.com
category: Testing
build-type: Simple
tested-with: ghc ==9.12.4
extra-source-files: test/Fixture/server.py

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates

  build-depends:
    base >=4.21 && <4.22,
    bytestring >=0.12.2 && <0.13,
    containers >=0.7 && <0.8,
    hasql >=1.9.3.1 && <1.10,
    shoko-core >=0.1 && <0.2,
    text >=2.1.4 && <2.2,

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Shoko.Adapter.Http
    Shoko.Adapter.Http.Evidence
    Shoko.Adapter.Http.Request
    Shoko.Adapter.Postgres
    Shoko.Adapter.Postgres.Evidence
    Shoko.Adapter.Postgres.Query

  build-depends:
    http-client >=0.7.19 && <0.8,
    http-client-tls >=0.3.6.4 && <0.4,
    http-types >=0.12.4 && <0.13,

test-suite postgres-adapter-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: PostgresMain.hs
  other-modules: AdapterTests
  ghc-options: -threaded
  build-depends:
    hedgehog >=1.5 && <1.8,
    shoko-adapters,
    tasty >=1.5.4 && <1.6,
    tasty-hedgehog >=1.4.0.2 && <1.5,

test-suite http-adapter-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: HttpMain.hs
  other-modules: AdapterTests
  ghc-options: -threaded
  build-depends:
    hedgehog >=1.5 && <1.8,
    shoko-adapters,
    tasty >=1.5.4 && <1.6,
    tasty-hedgehog >=1.4.0.2 && <1.5,

test-suite adapter-roundtrip-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: RoundtripMain.hs
  other-modules: AdapterTests
  ghc-options: -threaded
  build-depends:
    hedgehog >=1.5 && <1.8,
    shoko-adapters,
    tasty >=1.5.4 && <1.6,
    tasty-hedgehog >=1.4.0.2 && <1.5,

source-repository head
  type: git
  location: https://github.com/shinzui/shoko
