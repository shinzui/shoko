cabal-version: 3.12
name: shoko-core
version: 0.2.0.0
synopsis: Evidence-based distributed workflow verification
description:
  Inspectable typed workflow descriptions, capability preflight, and a bounded
  three-valued verification runner with explicit evidence and versioned results.

license: BSD-3-Clause
license-file: LICENSE
author: Shoko contributors
maintainer: shinzui@users.noreply.github.com
category: Testing
build-type: Simple
extra-doc-files: CHANGELOG.md
extra-source-files:
  test/UpdateGoldens.hs
  test/golden/*.json
  test/golden/README.md

tested-with: ghc ==9.12.4

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints

  build-depends:
    base >=4.21 && <4.22,
    text >=2.1.4 && <2.2,

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Shoko
    Shoko.Action
    Shoko.Binding
    Shoko.Clock
    Shoko.Compose
    Shoko.Correlation
    Shoko.Environment
    Shoko.Evidence
    Shoko.Expectation
    Shoko.Identifier
    Shoko.Observation
    Shoko.Prelude
    Shoko.Result
    Shoko.Result.Json
    Shoko.Runner
    Shoko.Scenario

  other-modules:
    Shoko.Internal.Binding
    Shoko.Internal.Call
    Shoko.Internal.Correlation
    Shoko.Internal.Digest
    Shoko.Internal.Reference

  build-depends:
    aeson >=2.2.4.1 && <2.4,
    async >=2.2.6 && <2.3,
    bytestring >=0.12.2 && <0.13,
    containers >=0.7 && <0.8,
    cryptohash-sha256 >=0.11.102.1 && <0.12,
    effectful-core >=2.6.1 && <2.8,
    time >=1.14 && <1.15,

test-suite shoko-core-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    ComposeSpec
    Consumer.Account
    Consumer.Composed
    Consumer.DeliveryLedger
    Consumer.Hooks
    Consumer.Idempotency
    CorrelationSpec
    CoverageSpec
    FaultSpec
    GoldenFixtures
    HandlerSpec
    IdempotencySpec
    PolicySpec
    ResultSpec
    RuntimeSpec
    ScenarioSpec
    TemporalSpec

  ghc-options:
    -threaded
    -rtsopts

  build-depends:
    aeson >=2.2.4.1 && <2.4,
    async >=2.2.6 && <2.3,
    bytestring >=0.12.2 && <0.13,
    containers >=0.7 && <0.8,
    hedgehog >=1.5 && <1.8,
    shoko-core,
    tasty >=1.5.4 && <1.6,
    tasty-hedgehog >=1.4.0.2 && <1.5,
    time >=1.14 && <1.15,

source-repository head
  type: git
  location: https://github.com/shinzui/shoko
