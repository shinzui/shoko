cabal-version: 3.12
name: shoko-core
version: 0.1.0.0
synopsis: Evidence-based distributed workflow verification
description:
  Core library for Shoko. The initial release establishes the build
  boundary; scenario descriptions and execution follow in the bounded runner.

license: BSD-3-Clause
license-file: LICENSE
author: Shoko contributors
maintainer: shinzui@users.noreply.github.com
category: Testing
build-type: Simple
extra-doc-files: CHANGELOG.md
tested-with: ghc ==9.12.4

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints

  build-depends:
    base >=4.21 && <4.22,
    text >=2.1.4 && <2.2,

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Shoko
    Shoko.Prelude

test-suite shoko-core-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts

  build-depends:
    hedgehog >=1.5 && <1.8,
    shoko-core,
    tasty >=1.5.4 && <1.6,
    tasty-hedgehog >=1.4.0.2 && <1.5,

source-repository head
  type: git
  location: https://github.com/shinzui/shoko
