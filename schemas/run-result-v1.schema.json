{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shoko run result v1",
  "description": "Finite verification evidence, runner faults, and preflight errors. Public fixture values are excluded. Monotonic times are microseconds, UTC times are ISO 8601.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "verification"
        },
        "report": {
          "$ref": "#/$defs/report"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "report"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "runner-fault"
        },
        "reason": {
          "type": "string",
          "enum": [
            "satisfied",
            "mismatch",
            "source-unavailable",
            "deadline-exceeded",
            "coverage-incomplete",
            "correlation-lost",
            "prerequisite-unavailable",
            "missing-occurrence-identity",
            "undeclared-operation",
            "invalid-evidence",
            "unexpected-runner-fault"
          ]
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/report"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "reason",
        "report"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "preflight-error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflightError"
          },
          "minItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "errors"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read-state",
              "read-events",
              "write-state",
              "send-http",
              "external-side-effect",
              "synthetic-resource"
            ]
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "substeps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "read-state",
                    "read-events",
                    "write-state",
                    "send-http",
                    "external-side-effect",
                    "synthetic-resource"
                  ]
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "capabilities"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "operationId",
        "capabilities",
        "dependencies",
        "substeps"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "type": "boolean"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "acceptedOutcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "nodeId",
        "fixture",
        "operation",
        "acceptedOutcomes"
      ],
      "additionalProperties": false
    },
    "expectationDescription": {
      "type": "object",
      "properties": {
        "expectationId": {
          "type": "string",
          "minLength": 1
        },
        "temporal": {
          "type": "string",
          "enum": [
            "eventually",
            "never",
            "exactly-once"
          ]
        },
        "windowsMicros": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1000,
            "multipleOf": 1000
          }
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "predicateId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "expectationId",
        "temporal",
        "windowsMicros",
        "operation",
        "predicateId"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "expectations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectationDescription"
          },
          "minItems": 1
        }
      },
      "required": [
        "scenarioId",
        "title",
        "revision",
        "nodes",
        "expectations"
      ],
      "additionalProperties": false
    },
    "substep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0
        },
        "finishedAt": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "enum": [
            "satisfied",
            "mismatch",
            "source-unavailable",
            "deadline-exceeded",
            "coverage-incomplete",
            "correlation-lost",
            "prerequisite-unavailable",
            "missing-occurrence-identity",
            "undeclared-operation",
            "invalid-evidence",
            "unexpected-runner-fault"
          ]
        }
      },
      "required": [
        "id",
        "startedAt",
        "finishedAt",
        "reason"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "declaredOutcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "observedOutcome": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0
        },
        "finishedAt": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "enum": [
            "satisfied",
            "mismatch",
            "source-unavailable",
            "deadline-exceeded",
            "coverage-incomplete",
            "correlation-lost",
            "prerequisite-unavailable",
            "missing-occurrence-identity",
            "undeclared-operation",
            "invalid-evidence",
            "unexpected-runner-fault"
          ]
        },
        "substeps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/substep"
          }
        },
        "supportingData": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        }
      },
      "required": [
        "nodeId",
        "operationId",
        "declaredOutcomes",
        "observedOutcome",
        "startedAt",
        "finishedAt",
        "reason",
        "substeps",
        "supportingData"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "integer",
          "minimum": 0
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "capturedAt",
        "cursor"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "strength": {
          "type": "string",
          "enum": [
            "sampled-state",
            "durable-history"
          ]
        },
        "fromMicros": {
          "type": "integer",
          "minimum": 0
        },
        "throughMicros": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "strength",
        "fromMicros",
        "throughMicros",
        "complete"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/baseline"
            },
            {
              "type": "null"
            }
          ]
        },
        "pollStartedAt": {
          "type": "integer",
          "minimum": 0
        },
        "finishedAt": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "matchingOccurrenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "matchCount": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "boolean"
        },
        "evidenceDeadline": {
          "type": "integer",
          "minimum": 0
        },
        "supportingData": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        }
      },
      "required": [
        "source",
        "operationId",
        "baseline",
        "pollStartedAt",
        "finishedAt",
        "coverage",
        "matchingOccurrenceIds",
        "matchCount",
        "gaps",
        "evidenceDeadline",
        "supportingData"
      ],
      "additionalProperties": false
    },
    "expectationResult": {
      "type": "object",
      "properties": {
        "expectationId": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "satisfied",
            "mismatch",
            "source-unavailable",
            "deadline-exceeded",
            "coverage-incomplete",
            "correlation-lost",
            "prerequisite-unavailable",
            "missing-occurrence-identity",
            "undeclared-operation",
            "invalid-evidence",
            "unexpected-runner-fault"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "expectationId",
        "verdict",
        "reason",
        "evidence"
      ],
      "additionalProperties": false
    },
    "parameter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "choice"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "count"
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "key",
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "flag"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "key",
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "logicalInput": {
      "type": "object",
      "properties": {
        "recipeRevision": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        }
      },
      "required": [
        "recipeRevision",
        "parameters"
      ],
      "additionalProperties": false
    },
    "correlation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "business-key"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "key",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "execution-id"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "namespaceUid": {
          "type": "string",
          "minLength": 1
        },
        "deploymentRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target",
        "namespaceUid",
        "deploymentRevision"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read-state",
              "read-events",
              "write-state",
              "send-http",
              "external-side-effect",
              "synthetic-resource"
            ]
          },
          "uniqueItems": true
        },
        "selectedCorrelation": {
          "type": "string",
          "enum": [
            "business-key",
            "execution-id"
          ]
        }
      },
      "required": [
        "requiredCapabilities",
        "selectedCorrelation"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "description": {
          "$ref": "#/$defs/description"
        },
        "descriptionDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "buildIdentity": {
          "type": "string",
          "minLength": 1
        },
        "implementationIdentity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "targetIdentity": {
          "anyOf": [
            {
              "$ref": "#/$defs/target"
            },
            {
              "type": "null"
            }
          ]
        },
        "logicalInput": {
          "$ref": "#/$defs/logicalInput"
        },
        "correlation": {
          "anyOf": [
            {
              "$ref": "#/$defs/correlation"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "executionStartedAt": {
          "type": "integer",
          "minimum": 0
        },
        "executionDeadline": {
          "type": "integer",
          "minimum": 0
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "expectations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectationResult"
          },
          "minItems": 1
        },
        "disposition": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cleaned",
              "retained",
              "failed",
              "timed-out"
            ]
          }
        }
      },
      "required": [
        "description",
        "descriptionDigest",
        "runId",
        "environment",
        "binding",
        "buildIdentity",
        "implementationIdentity",
        "targetIdentity",
        "logicalInput",
        "correlation",
        "policy",
        "startedAt",
        "finishedAt",
        "executionStartedAt",
        "executionDeadline",
        "verdict",
        "actions",
        "expectations",
        "disposition"
      ],
      "additionalProperties": false
    },
    "preflightError": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "missing-handler"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "missing-source"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "synthetic-consent-required"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "unsupported-correlation"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "missing-correlation-reference"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "production-unsupported"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "invalid-binding-identifier"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "invalid-logical-input"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "capabilities-denied"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "read-state",
                  "read-events",
                  "write-state",
                  "send-http",
                  "external-side-effect",
                  "synthetic-resource"
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "code",
            "capabilities"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "invalid-definition"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "invalid-identifier",
                      "duplicate-identifier",
                      "unresolved-reference",
                      "action-after-expectations",
                      "empty-outcome-contract",
                      "empty-expectations"
                    ]
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "id"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "code",
            "details"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
